<%- include('partials/header') %>

<section class="recent-work">
  <div class="container">
    <div class="section-title">
      <img src="/img/icon/Property 1=FULL.png" alt="icon" class="section-icon">
      <h2>OUR PROJECTS</h2>
    </div>

    <div class="projects-grid">
      <% data.recentWork.forEach(project => { %>
        <div class="project-tile <%= project.class %>">
          <div class="tile-overlay">
            <h3><%= project.title %></h3>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>